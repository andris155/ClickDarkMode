#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "program.ico"
IDI_ICON_SUN ICON "sun.ico"
IDI_ICON_MOON ICON "moon.ico"
IDI_ICON_SUN_WHITE ICON "sun-white.ico"
IDI_ICON_SUN_DARK ICON "sun-dark.ico"
IDI_ICON_MOON_WHITE ICON "moon-white.ico"
IDI_ICON_MOON_DARK ICON "moon-dark.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "andris155"
            VALUE "FileDescription",  "ClickDarkMode"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ClickDarkMode"
            VALUE "OriginalFilename", "ClickDarkMode.exe"
            VALUE "ProductName",      "ClickDarkMode"
            VALUE "ProductVersion",   "v1.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 andris155"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
