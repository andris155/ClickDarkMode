<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="ClickDarkMode"
           Manufacturer="andris155"
           Version="1.0.1.0"
           UpgradeCode="9F0FC1FB-9779-4C01-941B-4565D2DE2F2D"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ClickDarkMode is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.ProjectDir)\resources\program.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <!-- End-User License Agreement -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)\installer\License.rtf" />

    <util:CloseApplication Target="ClickDarkMode.exe" CloseMessage="yes" Description="ClickDarkMode is currently running. Please close it before continuing." RebootPrompt="no" />

    <StandardDirectory Id="SystemFolder" />

    <!-- Clean up startup registry entry on uninstall -->
    <CustomAction Id="CleanupStartupRun"
                  Directory="SystemFolder"
                  ExeCommand="reg.exe delete HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v ClickDarkMode /f"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CleanupStartupRun" Before="InstallFinalize" Condition="(NOT UPGRADINGPRODUCTCODE) AND (REMOVE=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClickDarkMode" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcutComponent" Guid="873D8A10-BD56-4F04-8039-3E8682FD4268">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="ClickDarkMode"
                  Description="Lightweight modern Windows 11 system tray dark and light mode switcher"
                  Target="[INSTALLFOLDER]ClickDarkMode.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\andris155\ClickDarkMode" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\andris155\ClickDarkMode" Action="removeOnUninstall" />
      </Component>
    </StandardDirectory>

    <!-- Optional Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="ApplicationDesktopShortcutComponent" Guid="38A5DEB0-4B93-4E90-A335-0479D5484ED5" Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="ClickDarkMode"
                  Description="Lightweight modern Windows 11 system tray dark and light mode switcher"
                  Target="[INSTALLFOLDER]ClickDarkMode.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\andris155\ClickDarkMode" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="ProductFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**">
        <Exclude Files="$(var.SourceDir)\*.pdb" />
        <Exclude Files="$(var.SourceDir)\*.lib" />
        <Exclude Files="$(var.SourceDir)\*.exp" />
        <Exclude Files="$(var.SourceDir)\*.iobj" />
        <Exclude Files="$(var.SourceDir)\*.ipdb" />
      </Files>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="ClickDarkMode" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
      <ComponentRef Id="ApplicationShortcutComponent" />
      <ComponentRef Id="ApplicationDesktopShortcutComponent" />
    </Feature>

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="1" Condition="1" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="15" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="70" Width="320" Height="30" Transparent="yes" NoPrefix="yes" Text="Choose whether you would like to create additional shortcuts:" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="25" Y="115" Width="320" Height="18"
                 Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1"
                 Text="Create a shortcut on the &amp;Desktop" />
      </Dialog>
    </UI>
  </Package>
</Wix>
